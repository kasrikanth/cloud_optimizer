# Copy to .env.production (kept out of git) before `npm run build`.
# The single dist/index.html calls this backend, so it must be a public HTTPS address.
# Boomi Flow pages are served over HTTPS; browsers block them from calling plain http:// APIs.
VITE_API_BASE_URL=https://your-api.example.com
# Never put cloud, database or LLM secrets in a VITE_ variable.
