# Local development only. scripts/setup.py generates the real values.
POSTGRES_DB=cloud_optimizer
POSTGRES_USER=optimizer
POSTGRES_PASSWORD=replace_with_a_random_password
# Host port 5433 avoids a conflict with a locally installed PostgreSQL.
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://optimizer:replace_with_a_random_password@127.0.0.1:5433/cloud_optimizer
# Organizations sign up in the app with an email and password. Sessions last this many hours.
SESSION_HOURS=12
# Encrypts cloud credentials at rest (Fernet key). scripts/setup.py generates one. Losing it means re-entering credentials.
SECRETS_KEY=replace_with_a_fernet_key
# Background collectors: demo/aws/azure accounts are re-synced when older than this many minutes.
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# OpenAI settings for every AI feature (Ask Stratus, monitor diagnosis, executive summary, approval assist, anomaly explanation,
# spend forecast explanation, finding explanations). The key and model are read ONLY from here; leave LLM_API_KEY empty to turn AI off.
# Restart the backend after editing. Example model: gpt-4o-mini. Any OpenAI-compatible HTTPS endpoint works via LLM_BASE_URL.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
