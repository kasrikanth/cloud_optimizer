# Cloud PostgreSQL endpoint. URL-encode special characters in user/password.
# The backend supplies certifi's CA bundle for verify-full unless sslrootcert is set.
DATABASE_URL=postgresql+psycopg://YOUR_USERNAME:YOUR_URL_ENCODED_PASSWORD@YOUR_HOST:5432/postgres?sslmode=verify-full&connect_timeout=15
SECRETS_KEY=replace_with_a_fernet_key
SESSION_HOURS=12
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
